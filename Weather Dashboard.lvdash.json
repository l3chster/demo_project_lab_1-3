            "expr": "COUNT_IF(snowfall_sum > 0)",
            "displayName": "Snowy Records Count",
            "comment": "Count of records where snowfall_sum is greater than 0"
          }
        ]
      }
    },
    {
      "name": "1161ada3",
      "displayName": "fact_weather",
      "config": {
        "version": "1.1",
        "source": "dbr_dev.weather_gold.fact_weather",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "hot_days_count",
            "expr": "COUNT_IF(temperature > 20)",
            "displayName": "Count of Records with Hot Days",
            "comment": "Count of records where temperature is above 20 degrees"
          },
          {
            "name": "mild_days_count",
            "expr": "COUNT_IF(temperature >= 10 AND temperature <= 20)",
            "displayName": "Count of Records with Mild Days",
            "comment": "Count of records where temperature is between 10 and 20 degrees"
          },
          {
            "name": "cold_days_count",
            "expr": "COUNT_IF(temperature < 10)",
            "displayName": "Count of Records with Cold Days",
            "comment": "Count of records where temperature is below 10 degrees"
          }
        ]
      }
    },
    {
      "name": "city_avg_rainfall",
      "displayName": "City Avg Rainfall",
      "queryLines": [
        "SELECT\n",
        "  d.city,\n",
        "  d.lat,\n",
        "  d.lon,\n",
        "  AVG(f.rain_sum) AS avg_rain_sum,\n",
        "  SUM(f.rain_sum) AS total_rain_sum\n",
        "FROM\n",
        "  dbr_dev.weather_gold.dim_city d\n",
        "    JOIN dbr_dev.weather_gold.fact_rainfall f\n",
        "      ON d.city_id = f.city_id\n",
        "GROUP BY\n",
        "  d.city,\n",
        "  d.lat,\n",
        "  d.lon"
      ]
    },
    {
      "name": "city_hottest_days",
      "displayName": "City Hottest Days",
      "queryLines": [
        "WITH daily_winners AS (\n",
        "  SELECT\n",
        "    DATE_TRUNC('DAY', f.date_id) AS day,\n",
        "    d.city,\n",
        "    ROW_NUMBER() OVER (\n",
        "        PARTITION BY DATE_TRUNC('DAY', f.date_id)\n",
        "        ORDER BY MAX(f.temperature) DESC\n",
        "      ) AS rn\n",
        "  FROM\n",
        "    dbr_dev.weather_gold.fact_weather f\n",
        "      JOIN dbr_dev.weather_gold.dim_city d\n",
        "        ON f.city_id = d.city_id\n",
        "  GROUP BY\n",
        "    DATE_TRUNC('DAY', f.date_id),\n",
        "    d.city\n",
        "),\n",
        "city_wins AS (\n",
        "  SELECT\n",
        "    city,\n",
        "    COUNT(*) AS win_count\n",
        "  FROM\n",
        "    daily_winners\n",
        "  WHERE\n",
        "    rn = 1\n",
        "  GROUP BY\n",
        "    city\n",
        "),\n",
        "total AS (\n",
        "  SELECT\n",
        "    SUM(win_count) AS total_wins\n",
        "  FROM\n",
        "    city_wins\n",
        ")\n",
        "SELECT\n",
        "  cw.city,\n",
        "  cw.win_count,\n",
        "  ROUND(cw.win_count * 100.0 / t.total_wins, 1) AS win_percentage\n",
        "FROM\n",
        "  city_wins cw CROSS JOIN total t\n",
        "ORDER BY\n",
        "  win_percentage DESC"
      ]
    },
    {
      "name": "daily_max_temp",
      "displayName": "Daily Max Temperature",
      "queryLines": [
        "WITH daily_ranked AS (\n",
        "  SELECT\n",
        "    DATE_TRUNC('DAY', f.date_id) AS day,\n",
        "    d.city,\n",
        "    MAX(f.temperature) AS max_temperature,\n",
        "    ROW_NUMBER() OVER (\n",
        "        PARTITION BY DATE_TRUNC('DAY', f.date_id)\n",
        "        ORDER BY MAX(f.temperature) DESC\n",
        "      ) AS rn\n",
        "  FROM\n",
        "    dbr_dev.weather_gold.fact_weather f\n",
        "      JOIN dbr_dev.weather_gold.dim_city d\n",
        "        ON f.city_id = d.city_id\n",
        "  GROUP BY\n",
        "    DATE_TRUNC('DAY', f.date_id),\n",
        "    d.city\n",
        ")\n",
        "SELECT\n",
        "  day,\n",
        "  city,\n",
        "  max_temperature\n",
        "FROM\n",
        "  daily_ranked\n",
        "WHERE\n",
        "  rn = 1\n",
        "ORDER BY\n",
        "  day"
      ]
    }
  ],
