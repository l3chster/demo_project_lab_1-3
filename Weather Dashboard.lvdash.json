    {
      "name": "rainfall_snowfall_unpivot",
      "displayName": "rainfall_snowfall_heatmap",
      "queryLines": [
        "SELECT\n",
        "  city,\n",
        "  'Rainfall' AS metric_type,\n",
        "  total_rain AS value\n",
        "FROM\n",
        "  dbr_dev.weather_gold.gold_ly_agg_measurements\n",
        "UNION ALL\n",
        "SELECT\n",
        "  city,\n",
        "  'Snowfall' AS metric_type,\n",
        "  total_snowfall AS value\n",
        "FROM\n",
        "  dbr_dev.weather_gold.gold_ly_agg_measurements\n",
        "ORDER BY\n",
        "  city,\n",
        "  metric_type"
      ]
    }
  ],
